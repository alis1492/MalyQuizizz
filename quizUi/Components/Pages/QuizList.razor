@page "/quizzes"
@using quizShared.DTOs
@using quizUi.Services
@inject QuizApiService Api
@inject ILogger<QuizList> Logger
@inject NavigationManager Nav

<PageTitle>Quizy</PageTitle>

<h1>Dostępne quizy</h1>

@if (error is not null)
{
    <p class="error">@error</p>
    <button @onclick="LoadAsync">Spróbuj ponownie</button>
}
else if (quizzes is null)
{
    <p>Ładowanie quizów...</p>
}
else if (quizzes.Count == 0)
{
    <p>Nie ma jeszcze żadnych quizów.</p>
}
else
{
    <ul class="quiz-list">
        @foreach (var quiz in quizzes)
        {
            <li>
                <a href="/quiz/@quiz.Id">
                    <strong>@quiz.Title</strong>
                </a>
                <p>@quiz.Description</p>
                <small>
                    @quiz.Subject · @quiz.Questions.Count pytań · @quiz.Questions.Sum(q => q.Points) pkt
                </small>
                <button @onclick='() => Nav.NavigateTo($"quiz/{quiz.Id}/edit")'>
                    Edytuj
                </button>

                @if (confirmingDeleteId == quiz.Id)
                {
                    <div class="confirm-delete">
                        <span>Usunąć quiz?</span>
                        <button @onclick="() => DeleteAsync(quiz.Id)" disabled="@isDeleting">
                            @(isDeleting ? "Usuwanie..." : "Tak, usuń")
                        </button>
                        <button @onclick="CancelDelete" disabled="@isDeleting">Anuluj</button>
                    </div>
                }
                else
                {
                    <button @onclick="() => RequestDelete(quiz.Id)" disabled="@isDeleting">
                        Usuń
                    </button>
                }
            </li>
        }
    </ul>
}

@code {
    private List<QuizDTO>? quizzes;
    private string? error;

    private string? confirmingDeleteId;
    private bool isDeleting;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        error = null;
        quizzes = null;

        try
        {
            quizzes = await Api.GetQuizzesAsync() ?? [];
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load quiz list");
            error = "Nie udało się załadować listy quizów.";
        }
    }

    private void RequestDelete(string quizId)
    {
        confirmingDeleteId = quizId;
    }

    private void CancelDelete()
    {
        confirmingDeleteId = null;
    }

    private async Task DeleteAsync(string quizId)
    {
        if (isDeleting) return;
        isDeleting = true;
        error = null;

        try
        {
            await Api.DeleteQuizAsync(quizId);
            confirmingDeleteId = null;

            // Remove locally so the list updates without a re-fetch
            quizzes?.RemoveAll(q => q.Id == quizId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete quiz {QuizId}", quizId);
            error = "Nie udało się usunąć quizu.";
        }
        finally
        {
            isDeleting = false;
        }
    }
}